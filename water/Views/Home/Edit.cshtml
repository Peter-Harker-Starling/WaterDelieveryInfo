@model water.Models.WaterDeliveryInfo

@{
    ViewData["Title"] = "Edit";
}

<h1>編輯</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Edit" method="post" class="upload-card">
    <input type="hidden" asp-for="Id" />

    <div>
        <label>商品代號</label>
        <input asp-for="Product_Id" type="text" class="form-control" />
        <span asp-validation-for="Product_Id" class="text-danger"></span>
    </div>
    <div>
        <label>品名</label>
        <input asp-for="Product_Name" type="text" class="form-control" />
        <span asp-validation-for="Product_Name" class="text-danger"></span>
    </div>
    <div>
        <label>送水日期</label>
        <input asp-for="DeliveryDate" type="date" class="form-control" />
        <span asp-validation-for="DeliveryDate" class="text-danger"></span>
    </div>

    <div>
        <label>數量</label>
        <input asp-for="Quantity" type="number" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div>
        <label>剩餘桶數</label>
        <input asp-for="RemainingQuantity" type="number" class="form-control" />
        <span asp-validation-for="RemainingQuantity" class="text-danger"></span>
    </div>
    <div>
        <label>送水單號</label>
        <input asp-for="Sheet_Id" type="text" class="form-control" />
        <span asp-validation-for="Sheet_Id" class="text-danger"></span>
    </div>

    <div class="mt-4"></div>

    <button type="submit" class="btn btn-primary">儲存</button>
    <button type="button" class="btn btn-secondary" onclick="window.history.back();">取消</button>
</form>