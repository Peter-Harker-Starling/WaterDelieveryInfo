@model IEnumerable<water.Models.WaterDeliveryViewModel>

@{
    ViewData["Title"] = "Record";
    var emptyMessageStyle = Model.Any() ? "display:none;" : "";
}

@Html.AntiForgeryToken()

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1>紀錄</h1>
    <a asp-controller="WaterDelivery" asp-action="Upload" class="btn btn-success">上傳</a>
</div>

<div id="recordList">
    <p id="emptyMessage" class="text-center text-muted" style="@emptyMessageStyle">目前沒有送水紀錄。</p>

    @foreach (var item in Model)
    {
        <div class="record" id="record-@item.Record.Id">
            @if (item.DaysSincePrevious.HasValue)
            {
                <span class="record-badge">距離上次送水 @item.DaysSincePrevious.Value 天</span>
            }
            <div class="record-header">
                <span class="record-title">@item.Record.Product_Name</span>
                <span class="record-subtitle">代號：@item.Record.Product_Id</span>
            </div>
            <div class="record-grid">
                <div>
                    <span class="record-label">日期</span>
                    <span class="record-value">@item.Record.DeliveryDate.ToString("yyyy-MM-dd")</span>
                </div>
                <div>
                    <span class="record-label">數量</span>
                    <span class="record-value">@item.Record.Quantity 桶</span>
                </div>
                <div>
                    <span class="record-label">剩餘桶數</span>
                    <span class="record-value">@item.Record.RemainingQuantity 桶</span>
                </div>
                <div>
                    <span class="record-label">送水單號</span>
                    <span class="record-value">@item.Record.Sheet_Id</span>
                </div>
            </div>
            <div class="record-actions">
                <a asp-action="Edit" asp-route-id="@item.Record.Id" class="btn btn-warning">編輯</a>
                <button type="button" class="btn btn-danger" onclick="deleteRecord(@item.Record.Id, this)">刪除</button>
            </div>
        </div>
    }
</div>

<script>
    function deleteRecord(id, button) {
        if (!confirm("確定要刪除這筆送水紀錄嗎 ?")) return;

        button.disabled = true;

        fetch('@Url.Action("Delete", "Home")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `id=${id}&__RequestVerificationToken=${document.querySelector('input[name="__RequestVerificationToken"]').value}`
        }).then(res => {
            if (res.ok) {
                document.getElementById(`record-${id}`).remove();

                const recordCount = recordList.querySelectorAll(".record").length;

                if (recordCount === 0) {
                    document.getElementById("emptyMessage").style.display = "block";
                }
            } else {
                alert("刪除失敗，請稍後再試。");
                button.disabled = false;
            }
        }).catch(error => {
            button.disabled = false;
            console.error(error);
            alert("刪除失敗，請稍後再試。");
        });
    }
</script>
